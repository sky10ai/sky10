          "messagingWsUrl": { "type": "string" },
          "messagingHelperPath": { "type": "string" },
          "connectionId": { "type": "string" },
          "pollIntervalMs": { "type": "number" },
          "replayOnStart": { "type": "boolean" },
          "defaultAccount": { "type": "string" },
          "healthMonitor": {
            "type": "object",
