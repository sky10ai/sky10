{
  "id": "sky10",
  "channels": [
    "sky10",
    "telegram",
    "slack",
    "imap-smtp"
  ],
  "name": "Sky10 Channels",
  "version": "0.1.0",
  "description": "Connect OpenClaw agents to sky10 and sky10-backed messaging channels",
  "configSchema": {
    "type": "object",
    "properties": {
      "rpcUrl": {
        "type": "string",
        "default": "http://localhost:9101",
        "description": "Sky10 daemon RPC URL"
      },
      "agentName": {
        "type": "string",
        "description": "Name to register as on the sky10 network"
      },
      "skills": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["code", "shell", "browser", "web-search", "file-ops"],
        "description": "Skills to advertise on the sky10 network"
      },
      "gatewayUrl": {
        "type": "string",
        "default": "http://localhost:18789",
        "description": "OpenClaw gateway HTTP URL"
      },
      "gatewayToken": {
        "type": "string",
        "description": "Gateway API bearer token (if auth is enabled)"
      },
      "messagingWsUrl": {
        "type": "string",
        "description": "Optional sky10 messenger bridge websocket URL"
      },
      "connectionId": {
        "type": "string",
        "description": "Optional messaging connection ID to bind this account to"
      },
      "pollIntervalMs": {
        "type": "number",
        "default": 5000,
        "description": "Messaging bridge polling interval in milliseconds"
      },
      "replayOnStart": {
        "type": "boolean",
        "default": false,
        "description": "Replay existing messaging events when the gateway starts"
      }
    },
    "required": ["agentName"]
  },
  "channelConfigs": {
    "sky10": {
      "label": "Sky10",
      "description": "Direct sandbox bridge to the local sky10 daemon.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "rpcUrl": { "type": "string" },
          "agentName": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tools": {
            "type": "array",
            "items": { "type": "object" }
          },
          "manifestPath": { "type": "string" },
          "gatewayToken": { "type": "string" },
          "x402WsUrl": { "type": "string" },
          "x402HelperPath": { "type": "string" },
          "messagingWsUrl": { "type": "string" },
          "messagingHelperPath": { "type": "string" },
          "defaultAccount": { "type": "string" },
          "healthMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "telegram": {
      "label": "Telegram",
      "description": "Native Telegram chats through sky10 messaging connections.",
      "preferOver": ["telegram"],
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "rpcUrl": { "type": "string" },
          "agentName": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tools": {
            "type": "array",
            "items": { "type": "object" }
          },
          "manifestPath": { "type": "string" },
          "gatewayToken": { "type": "string" },
          "x402WsUrl": { "type": "string" },
          "x402HelperPath": { "type": "string" },
          "messagingWsUrl": { "type": "string" },
          "messagingHelperPath": { "type": "string" },
          "connectionId": { "type": "string" },
          "pollIntervalMs": { "type": "number" },
          "replayOnStart": { "type": "boolean" },
          "defaultAccount": { "type": "string" },
          "healthMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "slack": {
      "label": "Slack",
      "description": "Native Slack conversations through sky10 messaging connections.",
      "preferOver": ["slack"],
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "rpcUrl": { "type": "string" },
          "agentName": { "type": "string" },
          "skills": {
            "type": "array",
