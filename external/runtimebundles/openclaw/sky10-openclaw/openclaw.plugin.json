              "enabled": { "type": "boolean" }
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "imap-smtp": {
      "label": "IMAP/SMTP",
      "description": "Native email threads through sky10 IMAP/SMTP messaging connections.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
